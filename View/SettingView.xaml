<Window x:Class="KURSOVA.View.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:KURSOVA.ViewModel"
        xmlns:model="clr-namespace:KURSOVA.Model"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:KURSOVA.Converters"
        xmlns:loc="clr-namespace:KURSOVA.Localization" d:DataContext="{d:DesignInstance Type=vm:SettingViewModel}"
        
        mc:Ignorable="d"
        Title="Налаштування" 
        Width="450" 
        Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" d:DesignWidth="450"
        Background="{DynamicResource ContentBackgroundBrush}">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{loc:Loc Settings_Language}" 
                   Style="{DynamicResource BodyText}" 
                   VerticalAlignment="Center"
                   Margin="0,0,20,0"/>

        <ComboBox 
                  Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding AvailableLanguages}" 
                  SelectedItem="{Binding SelectedLanguage}" 
                  DisplayMemberPath="DisplayName"
                  Margin="10,0,0,0" 
                  Padding="10, 0, 4, 0"
                  Style="{DynamicResource ModernComboBox}"                     
                  ItemContainerStyle="{DynamicResource ModernComboBoxItem}"
                  VerticalAlignment="Center" 
                  Height="35"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="{loc:Loc Settings_Theme}"
                   Style="{StaticResource BodyText}"
                   VerticalAlignment="Center"
                   Margin="0,20,20,0"/>

        <StackPanel Grid.Row="1" Grid.Column="1"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="10,20,0,0"
                    VerticalAlignment="Center">
            <RadioButton Style="{DynamicResource ThemeToggleButtonStyle}"
                         
                         GroupName="Theme"
                         Margin="0,0,10,0"
                         Background="White"
                         Foreground="#1E293B"
                         BorderBrush="#CBD5E1"
                         ToolTip="{loc:Loc Settings_Theme_Light}"
                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"/>
            <RadioButton Style="{DynamicResource ThemeToggleButtonStyle}"
                         
                         GroupName="Theme"
                         Background="#1E293B"
                         Foreground="White"
                         BorderBrush="#334155"
                         ToolTip="{loc:Loc Settings_Theme_Dark}"
                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{loc:Loc Settings_Cancel}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{DynamicResource DangerButton}"
                    Width="100"
                    Height="35"
                    FontSize="14"/>
            <Button Content="{loc:Loc Settings_Apply}"
                    Command="{Binding ApplyCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Style="{DynamicResource SecondaryButton}"
                    Width="100"
                    Height="35"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>