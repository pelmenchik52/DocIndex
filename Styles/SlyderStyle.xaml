<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <s:Double x:Key="SliderThumbSize">16</s:Double>
    <s:Double x:Key="SliderTrackHeight">6</s:Double>

    <!-- Стиль для повзунка (Thumb) -->
    <ControlTemplate x:Key="SliderThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid>
            <!-- Круглий повзунок -->
            <Ellipse x:Name="EllipseElement"
                     Width="{StaticResource SliderThumbSize}"
                     Height="{StaticResource SliderThumbSize}"
                     StrokeThickness="2"
                     Stroke="{DynamicResource PrimaryBrush}"
                     Fill="{DynamicResource BackgroundBrush}">
                <Ellipse.Effect>
                    <!-- Невеликий ефект тіні для глибини -->
                    <DropShadowEffect ShadowDepth="1" Direction="270" Color="Black" Opacity="0.5" BlurRadius="4"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- Ефект при наведенні миші -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="EllipseElement" Property="Fill" Value="{DynamicResource PrimaryHoverBrush}"/>
            </Trigger>
            <!-- Ефект при натисканні -->
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="EllipseElement" Property="Fill" Value="{DynamicResource PrimaryPressedBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Стиль для елемента керування Slider -->
    <Style x:Key="ThemedSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="{StaticResource SliderThumbSize}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Track (Доріжка) -->
                        <Border x:Name="PART_TrackBorder"
                                Grid.Row="1"
                                Height="{StaticResource SliderTrackHeight}"
                                CornerRadius="3"
                                Background="{DynamicResource BorderBrush}"
                                Margin="{Binding Path=Margin, RelativeSource={RelativeSource Mode=TemplatedParent}}">

                            <Grid x:Name="HorizontalTrack">
                                <!-- Track Value Area (Заповнена частина доріжки) -->
                                <Border x:Name="PART_SelectionRange"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="3"
                                        Height="{StaticResource SliderTrackHeight}"/>
                            </Grid>
                        </Border>

                        <!-- Повзунок (Thumb) -->
                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Template="{StaticResource SliderThumbTemplate}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>