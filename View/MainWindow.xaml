<Window x:Class="KURSOVA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:KURSOVA.ViewModel"
        xmlns:model="clr-namespace:KURSOVA.Model"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:loc="clr-namespace:KURSOVA.Localization" xmlns:view="clr-namespace:KURSOVA.View"     
        Title="{loc:Loc WindowTitle}" 
        Height="800" Width="1400"
        MinHeight="700" MinWidth="1100"
        Background="{DynamicResource ContentBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <Menu DockPanel.Dock="Top" Background="{DynamicResource ContentBackgroundBrush}">
            <MenuItem Header="{loc:Loc Menu_File}">
                <MenuItem Header="{loc:Loc Menu_File_Save}" Command="{Binding btnSaveCorpus}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Menu_File_Exit }" Command="{Binding btnExitApp}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Menu_Settings}" Command="{Binding btnSetting}"/>
            <MenuItem Header="{loc:Loc Menu_Help}" Command="{Binding btnHelpMenu}"/>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ContentBackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentStatusMessage}" 
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="150" Height="18" 
                             IsIndeterminate="{Binding IsBusy}" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📄 Docergänger" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{loc:Loc WindowSubtitle}" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <view:ManagementView Grid.Column="0" />

                <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Margin="10,0,0,0">
                    <Grid>
                        <TabControl Grid.Row="0" Grid.RowSpan="2" 
                                    BorderThickness="0" 
                                    Background="Transparent">

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text="{loc:Loc Tab_Documents}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TabItem.Header>
                                <view:DocumentsView DataContext="{Binding DocumentsVM}"/>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text="{loc:Loc Tab_Similar}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TabItem.Header>
                                <view:SimilarView />
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text="{loc:Loc Tab_Clusters}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TabItem.Header>
                                <view:ClusterView />
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text="{loc:Loc Tab_Keywords}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TabItem.Header>
                                <view:KeywordsView DataContext="{Binding KeywordsVM}"/>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock Text="{loc:Loc Tab_Stats}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TabItem.Header>
                                <view:StatsView />
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>