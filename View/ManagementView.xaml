<UserControl x:Class="KURSOVA.View.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:KURSOVA.ViewModel"
             xmlns:model="clr-namespace:KURSOVA.Model"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:loc="clr-namespace:KURSOVA.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300">

    <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,10,0">
        <ScrollViewer Style="{DynamicResource ModernScrollViewer}" 
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc Manage_Title}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

                <TextBlock Text="{loc:Loc Manage_ImportSection}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>

                <Button Command="{Binding btnImportFiles}"
                        Content="{loc:Loc Manage_ImportFiles}" 
                        Style="{DynamicResource ModernButton}"
                        Margin="0,0,0,8" Height="35"/>
                <Button Command="{Binding btnImportFolder}" 
                        Content="{loc:Loc Manage_ImportFolder}" 
                        Style="{DynamicResource ModernButton}"
                        Margin="0,0,0,8" Height="35"/>
                <Button Command="{Binding btnLoadCorpus}" 
                        Content="{loc:Loc Manage_LoadCorpus}" 
                        Style="{DynamicResource ModernButton}"
                    Margin="0,0,0,20" Height="35"/>

                <Separator Margin="0,0,0,20" Background="{DynamicResource BorderBrush}"/>

                <TextBlock Text="{loc:Loc Manage_IndexingSection}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <Button Command="{Binding btnBuildIndex}" 
                        Content="{loc:Loc Manage_BuildIndex}" 
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,8" Height="35"/>
                <TextBlock Text="{Binding IndexStatus}" 
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <Separator Margin="0,0,0,20" Background="{DynamicResource BorderBrush}"/>

                <TextBlock Text="{loc:Loc Manage_AnalysisSection}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <Button Command="{Binding BtnFindSimmilar}" 
                        Content="{loc:Loc Manage_FindSimilar}" 
                        Style="{DynamicResource ModernButton}"
                        Margin="0,0,0,8" Height="35"/>
                <Button Command="{Binding BtnClasterization}" 
                        Content="{loc:Loc Manage_Clustering}" 
                        Style="{DynamicResource ModernButton}"
                        Margin="0,0,0,8" Height="35"/>

                <TextBlock Text="{loc:Loc Manage_ClusterCount}" 
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Value, ElementName=sliderClusterCount}" 
                               DockPanel.Dock="Right" 
                               FontWeight="Bold" Width="30" TextAlignment="Right" Margin="5,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="sliderClusterCount"
                            Value="{Binding ClusterCount, Mode=TwoWay}" 
                            Minimum="2" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                            Style="{DynamicResource ThemedSliderStyle}"/>
                </DockPanel>

                <Button Command="{Binding BtnFrequencyDictionary}" 
                        Content="{loc:Loc Manage_FreqDict}" 
                        Style="{DynamicResource ModernButton}"
                        Margin="0,0,0,20" Height="35"/>

                <Separator Margin="0,0,0,20" Background="{DynamicResource BorderBrush}"/>

                <Button Command="{Binding btnSaveCorpus}"
                        Content="{loc:Loc Manage_Save}" 
                        Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,0,8" Height="35"/>
                <Button Command="{Binding BtnClear}"
                        Content="{loc:Loc Manage_ClearAll}" 
                        Style="{DynamicResource DangerButton}" Height="35"/>

                <Separator Margin="0,20,0,20" Background="{DynamicResource BorderBrush}"/>

                <TextBlock Text="{loc:Loc Manage_StatsSection}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource DisabledBrush}" 
                        CornerRadius="6" 
                        Padding="12">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                            <Run Text="{loc:Loc Stats_DocsCount}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Source={x:Static model:Corpus.Instance}, 
                                                    Mode=OneWay,
                                                 Path=Documents.Count, 
                                                 StringFormat={}{0}, 
                                                 ConverterCulture='uk-UA'}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                            <Run Text="{loc:Loc Stats_UniqueWords}"/>
                            <Run Text=" "/>
                           <Run Text="{Binding StatsVM.UniqueWordCount, StringFormat={}{0}}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{loc:Loc Stats_AvgLength}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding StatsVM.AvgDocLength, StringFormat={}{0:F0}}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Separator Margin="0,20,0,20" Background="{DynamicResource BorderBrush}"/>

                <TextBlock Text="{loc:Loc Manage_LogTitle}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding LogMessages}"
                         Height="150"
                         Style="{DynamicResource ModernListBox}"
                         FontSize="10"
                         ItemContainerStyle="{DynamicResource ListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox> 
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>