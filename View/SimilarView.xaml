<UserControl x:Class="DocIndex.View.SimilarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:DocIndex.ViewModel"
             xmlns:model="clr-namespace:DocIndex.Model"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:loc="clr-namespace:DocIndex.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Similar_InfoText}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}" 
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="1">

            <TextBlock x:Name="EmptyMessage"
                       Text="{loc:Loc Similar_IndexRequired}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Opacity="0.7">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SimilarResults.Count, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" 
                                         Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>


            <ListBox ItemsSource="{Binding DataContext.SimilarResults, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" 
                     Style="{DynamicResource ModernListBox}"
                     ItemContainerStyle="{DynamicResource ListBoxItemStyle}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DocumentTitle}" 
                                           FontWeight="SemiBold" 
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="{Binding DocumentId, StringFormat='ID: {0}'}" 
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="1" 
                                    Background="White" CornerRadius="12"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">

                                <TextBlock Text="{Binding Score, StringFormat='{}{0:P0}', ConverterCulture='uk-UA'}" 
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>