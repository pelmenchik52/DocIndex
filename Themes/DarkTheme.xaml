<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryHoverColor">#4F46E5</Color>
    <Color x:Key="PrimaryPressedColor">#4338CA</Color>
    <Color x:Key="SecondaryColor">#22a06f</Color>
    <Color x:Key="SecondaryHoverColor">#1e9060</Color>
    <Color x:Key="SecondaryPressedColor">#1a8053</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#E11D48</Color>
    <Color x:Key="DangerPressedColor">#BE123C</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>

    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="DisabledColor">#334155</Color>
    <Color x:Key="DisabledForegroundColor">#64748B</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="BackgroundColor">#1E293B</Color>
    <Color x:Key="InfoBackgroundColor">#162E24</Color>
    <Color x:Key="InfoBorderColor">#166534</Color>
    <Color x:Key="InfoForegroundPrimaryColor">#86EFAC</Color>
    <Color x:Key="InfoForegroundSecondaryColor">#A7F3D0</Color>
    <Color x:Key="AlternatingRowColor">#242F40</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="{StaticResource SecondaryPressedColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackgroundColor}"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}"/>
    <SolidColorBrush x:Key="InfoForegroundPrimaryBrush" Color="{StaticResource InfoForegroundPrimaryColor}"/>
    <SolidColorBrush x:Key="InfoForegroundSecondaryBrush" Color="{StaticResource InfoForegroundSecondaryColor}"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="{StaticResource AlternatingRowColor}"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#293548"/>
    

</ResourceDictionary>