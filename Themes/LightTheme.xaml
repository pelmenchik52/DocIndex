<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#6366F1</Color>
    <Color x:Key="PrimaryHoverColor">#4F46E5</Color>
    <Color x:Key="PrimaryPressedColor">#4338CA</Color>
    <Color x:Key="SecondaryColor">#2fd68c</Color>
    <Color x:Key="SecondaryHoverColor">#27be7a</Color>
    <Color x:Key="SecondaryPressedColor">#21a36a</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#E11D48</Color>
    <Color x:Key="DangerPressedColor">#BE123C</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="DisabledColor">#F1F5F9</Color>
    <Color x:Key="DisabledForegroundColor">#94A3B8</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ShadowColor">#0F172A</Color>
    <Color x:Key="BackgroundColor">#F8FAFC</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource SecondaryHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="{StaticResource SecondaryPressedColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="InfoForegroundPrimaryBrush" Color="#166534"/>
    <SolidColorBrush x:Key="InfoForegroundSecondaryBrush" Color="#15803D"/>

    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF"/>
    
</ResourceDictionary>